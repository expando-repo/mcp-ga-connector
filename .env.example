# Google OAuth 2.0 (z Google Cloud Console)
GOOGLE_CLIENT_ID=123456789-abcdefgh.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# URL tvého serveru (bez trailing slash, musí být HTTPS v produkci)
BASE_URL=https://mcp.vasedomena.cz

# Náhodný tajný klíč - vygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=nahrad_toto_nahodnym_klicem_64_znaku

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://mcpuser:heslo@localhost:5432/mcpdb

# Volitelné
MCP_SERVER_NAME=google-analytics
